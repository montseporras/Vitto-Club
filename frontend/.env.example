# Copiá este archivo a `.env.local` si necesitás cambiar algo.
# `.env.local` está en el .gitignore: cada integrante crea el suyo.

# URL base de la API de NestJS (default: http://localhost:3000/api)
VITE_API_URL=http://localhost:3000/api

# En desarrollo, MSW simula la API con datos de prueba (los mocks de src/mocks).
#   true  (o sin definir) -> usa los mocks, no hace falta levantar el backend.
#   false                 -> le pega al backend real (ej.: empleados en /api/empleados).
# Para ver el front conectado al backend, poné `false` en tu `.env.local`.
# Después de cambiarla, reiniciá `npm run dev` y recargá con Ctrl+Shift+R.
VITE_API_MOCKS=true
