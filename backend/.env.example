# Copiá este archivo a `.env`. Estos valores coinciden con el docker-compose.yml
# de la raíz del repo (servicio `db`, puerto publicado 5433 -> 5432 del contenedor).
# Si usás tu propio PostgreSQL en vez de Docker, reemplazá la connection string.

DATABASE_URL="postgresql://vitto:vitto_dev@localhost:5433/vitto_club"

# Base para los tests e2e (npm run test:e2e). Tiene que ser local y llevar "test" en el
# nombre: si no, los tests se niegan a correr. Se crea una vez con:
#   docker exec vitto_db createdb -U vitto vitto_club_test
DATABASE_URL_TEST="postgresql://vitto:vitto_dev@localhost:5433/vitto_club_test"

# Puerto en el que escucha la API de NestJS (opcional, default 3000).
PORT=3000

# --- Seed (npx prisma db seed) ---
# Administrador inicial: se crea siempre (empleado + cuenta). Todos obligatorios.
# La contraseña NUNCA se commitea: completala solo en tu .env.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=

# Datos de prueba (empleados, clientes y sus cuentas). Solo desarrollo:
# con NODE_ENV=production el seed se niega a cargarlos.
SEED_DEMO_DATA=false
# Una sola contraseña para todas las cuentas de prueba. Obligatoria si SEED_DEMO_DATA=true.
SEED_DEMO_PASSWORD=

# Costo de bcrypt (4 a 15). En tests conviene bajarlo a 4.
BCRYPT_COST=10



# --- Autenticación ---
# Secreto con el que se firman los access tokens. Mínimo 32 caracteres. NUNCA se commitea
# el valor real. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vida del access token, en segundos (15 minutos).
JWT_ACCESS_TTL_SECONDS=900

# Sesión de empleados (Cajero y Administrador), en segundos:
# 30 minutos sin actividad, 12 horas como máximo.
SESSION_EMPLOYEE_INACTIVITY_SECONDS=1800
SESSION_EMPLOYEE_ABSOLUTE_SECONDS=43200

# Sesión de clientes, en segundos: 7 días sin actividad, 30 días como máximo.
SESSION_CUSTOMER_INACTIVITY_SECONDS=604800
SESSION_CUSTOMER_ABSOLUTE_SECONDS=2592000

# --- Vencimiento automático de puntos (US-25) ---
# El proceso corre todos los días a las 00:05, hora de Argentina. Con false no corre (los e2e
# lo apagan). Sin la variable, queda prendido. Para correrlo a demanda: npm run points:expire
POINTS_EXPIRATION_CRON_ENABLED=true

# --- Recompensas vencidas (US-37) ---
# El proceso corre todos los días a las 00:05, hora de Argentina, y al iniciar el servidor. Con false
# no corre (los e2e lo apagan). Sin la variable, queda prendido. A demanda: npm run rewards:expire
REWARDS_EXPIRATION_CRON_ENABLED=true

# --- Canjes vencidos (US-44) ---
# El proceso corre cada 5 minutos y al iniciar el servidor. Con false no corre (los e2e lo apagan).
# Sin la variable, queda prendido. A demanda: npm run redemptions:expire
REDEMPTIONS_EXPIRATION_CRON_ENABLED=true

# --- Promociones programadas (Sprint 5, US-15) ---
# El proceso corre cada minuto: saca los envíos programados que ya están en hora. Con false no corre (los e2e lo
# apagan). Sin la variable, queda prendido. A demanda: npm run promotions:send
PROMOTIONS_CRON_ENABLED=true

# --- Avisos diarios: vencimiento de puntos y cumpleaños (Sprint 5, US-47 y US-48) ---
# El proceso corre todos los días a las 09:00, hora de Argentina (no corre al iniciar el servidor). Con false no corre
# (los e2e lo apagan). Sin la variable, queda prendido. A demanda: npm run notifications:send
NOTIFICATIONS_CRON_ENABLED=true

# --- Correo de las notificaciones (Sprint 5, BASE-5) ---
# Con true se manda con Resend; con false (o sin la variable) no se manda nada: el envío queda en el log
# y se registra como "No enviada". En desarrollo y en los e2e va en false. Con true, RESEND_API_KEY y
# NOTIFICATIONS_FROM son obligatorias. NUNCA se commitea la clave real: completala solo en tu .env.
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=
# Remitente de los correos, por ejemplo: Vitto Club <avisos@tu-dominio.com>
NOTIFICATIONS_FROM=

# --- Imágenes (Sprint 5, BASE-5) ---
# Con true se guardan en Cloudinary; con false (o sin la variable) se usa un adaptador falso que valida el
# archivo pero no sube nada. En desarrollo sin cuenta y en los e2e va en false. Con true, las tres
# variables de Cloudinary son obligatorias. NUNCA se commitean los valores reales.
IMAGES_STORAGE_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ---
# Orígenes del frontend que la API acepta, separados por coma. Sin la variable, solo
# http://localhost:5173 (Vite). Para un deploy: CORS_ORIGIN=https://tu-front.vercel.app
CORS_ORIGIN=http://localhost:5173
