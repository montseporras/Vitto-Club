# Copiá este archivo a `.env`. Estos valores coinciden con el docker-compose.yml
# de la raíz del repo (servicio `db`, puerto publicado 5433 -> 5432 del contenedor).
# Si usás tu propio PostgreSQL en vez de Docker, reemplazá la connection string.

DATABASE_URL="postgresql://vitto:vitto_dev@localhost:5433/vitto_club"

# Base para los tests e2e (npm run test:e2e). Tiene que ser local y llevar "test" en el
# nombre: si no, los tests se niegan a correr. Se crea una vez con:
#   docker exec vitto_db createdb -U vitto vitto_club_test
DATABASE_URL_TEST="postgresql://vitto:vitto_dev@localhost:5433/vitto_club_test"

# Puerto en el que escucha la API de NestJS (opcional, default 3000).
PORT=3000

# --- Seed (npx prisma db seed) ---
# Administrador inicial: se crea siempre (empleado + cuenta). Todos obligatorios.
# La contraseña NUNCA se commitea: completala solo en tu .env.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=

# Datos de prueba (empleados, clientes y sus cuentas). Solo desarrollo:
# con NODE_ENV=production el seed se niega a cargarlos.
SEED_DEMO_DATA=false
# Una sola contraseña para todas las cuentas de prueba. Obligatoria si SEED_DEMO_DATA=true.
SEED_DEMO_PASSWORD=

# Costo de bcrypt (4 a 15). En tests conviene bajarlo a 4.
BCRYPT_COST=10
