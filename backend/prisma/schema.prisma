generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  ADMIN
  CASHIER
}

enum DocumentType {
  DNI
  PASSPORT
}

/// Employees: required data: first name, last name, phone and role.
model Employee {
  id        Int          @id @default(autoincrement())
  firstName String       @map("first_name") @db.VarChar(80)
  lastName  String       @map("last_name") @db.VarChar(80)
  phone     String       @db.VarChar(30)
  email     String       @db.VarChar(150)
  role      EmployeeRole

  // Soft delete: record is kept, not removed
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([isActive])
  @@map("employees")
}

/// Customers: document, email (required), phone (optional), first name, last name.
model Customer {
  id             Int          @id @default(autoincrement())
  firstName      String       @map("first_name") @db.VarChar(80)
  lastName       String       @map("last_name") @db.VarChar(80)
  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number") @db.VarChar(20)
  email          String       @db.VarChar(150)
  phone          String?      @db.VarChar(30)

  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  // Soft delete: record is kept, not removed, to preserve history
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  statusChanges CustomerStatusChange[]

  // The document identifies the customer at checkout: must not repeat
  @@unique([documentType, documentNumber], name: "unique_document")
  @@index([lastName, firstName])
  @@index([isActive])
  @@map("customers")
}

enum CustomerStatusAction {
  DEACTIVATED
  ACTIVATED
}

/// History of deactivations and reactivations of a customer (never deleted).
model CustomerStatusChange {
  id         Int                  @id @default(autoincrement())
  customerId Int                  @map("customer_id")
  action     CustomerStatusAction
  createdAt  DateTime             @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_status_changes")
}
