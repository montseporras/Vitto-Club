generator client {
  provider        = "prisma-client-js"
  // Unique indexes with a WHERE clause (customers: unique only among active ones)
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  ADMIN
  CASHIER
}

enum DocumentType {
  DNI
  PASSPORT
}

/// Employees: required data: first name, last name, phone and role.
model Employee {
  id        Int          @id @default(autoincrement())
  firstName String       @map("first_name") @db.VarChar(80)
  lastName  String       @map("last_name") @db.VarChar(80)
  phone     String       @db.VarChar(30)
  email     String       @unique @db.VarChar(150)
  role      EmployeeRole

  // Soft delete: record is kept, not removed
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account?

  @@index([isActive])
  @@map("employees")
}

/// Customers: document, email (required, unique), phone (optional), first name, last name.
model Customer {
  id             Int          @id @default(autoincrement())
  firstName      String       @map("first_name") @db.VarChar(80)
  lastName       String       @map("last_name") @db.VarChar(80)
  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number") @db.VarChar(20)
  email          String       @db.VarChar(150)
  phone          String?      @db.VarChar(30)

  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  // Soft delete: record is kept, not removed, to preserve history
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statusChanges CustomerStatusChange[]
  account       Account?

  // Document and email must not repeat among ACTIVE customers (PO decision, 2026-10-08): a
  // deactivated customer lost their points and can sign up again as a new customer.
  @@unique([documentType, documentNumber], map: "customers_active_document_key", where: { isActive: true })
  @@unique([email], map: "customers_active_email_key", where: { isActive: true })
  // Lookup by document also has to find inactive customers (checkout identification)
  @@index([documentType, documentNumber])
  @@index([lastName, firstName])
  @@index([isActive])
  @@map("customers")
}

enum CustomerStatusAction {
  DEACTIVATED
  ACTIVATED
}

/// History of deactivations and reactivations of a customer (never deleted).
model CustomerStatusChange {
  id         Int                  @id @default(autoincrement())
  customerId Int                  @map("customer_id")
  action     CustomerStatusAction
  createdAt  DateTime             @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_status_changes")
}

enum AccountRole {
  ADMIN
  CASHIER
  CUSTOMER
}

enum FirstPurchaseBonusType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Login credentials. Everyone logs in with an email, employees and customers alike.
/// Exactly one owner, matching the role: CUSTOMER -> customerId; ADMIN/CASHIER -> employeeId.
/// Enforced by the CHECK constraint "accounts_owner_matches_role_check", written by hand in the
/// migration (Prisma does not model CHECK constraints).
model Account {
  id           Int         @id @default(autoincrement())
  // Copy of Employee.email (not editable) or Customer.email (kept in sync when it changes).
  // One email = one account: the same person needs a different email per role.
  email        String      @unique @db.VarChar(150)
  passwordHash String      @map("password_hash")
  // Derived copy of Employee.role (source of truth); always CUSTOMER for customers
  role         AccountRole

  isActive Boolean @default(true) @map("is_active")

  employeeId Int? @unique @map("employee_id")
  customerId Int? @unique @map("customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessions Session[]

  @@map("accounts")
}

/// One row per login session. The refresh token is rotated in place on every use.
model Session {
  id        Int    @id @default(autoincrement())
  accountId Int    @map("account_id")
  // SHA-256 (hex) of the refresh token; the token itself is never stored
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  // Inactivity deadline: pushed forward on every refresh
  expiresAt         DateTime  @map("expires_at")
  // Hard limit: set at login, never changes
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("sessions")
}

/// Current global rule for converting purchase amounts into loyalty points.
/// The primary key is constrained to 1 so the table stores exactly one active configuration.
model LoyaltyPointsConfiguration {
  id            Int      @id @default(1)
  baseAmount    Decimal  @map("base_amount") @db.Decimal(12, 2)
  pointsAwarded Int      @map("points_awarded")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("loyalty_points_configuration")
}

/// Current global points expiration period, measured from the point accreditation date.
model LoyaltyPointsValidityConfiguration {
  id                     Int      @id @default(1)
  pointsExpirationMonths Int      @default(12) @map("points_expiration_months")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("loyalty_points_validity_configuration")
}

/// Current global bonus granted in addition to the normal points for a customer's first purchase.
model FirstPurchaseBonusConfiguration {
  id         Int                    @id @default(1)
  bonusType  FirstPurchaseBonusType @map("bonus_type")
  bonusValue Decimal                @map("bonus_value") @db.Decimal(12, 2)
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  @@map("first_purchase_bonus_configuration")
}

/// Immutable version of all loyalty program settings. Exactly one version is active at a time.
model LoyaltyProgramConfiguration {
  id                     Int                     @id @default(autoincrement())
  version                Int                     @unique
  baseAmount             Decimal?                @map("base_amount") @db.Decimal(12, 2)
  pointsAwarded          Int?                    @map("points_awarded")
  pointsExpirationMonths Int                     @default(12) @map("points_expiration_months")
  bonusType              FirstPurchaseBonusType? @map("bonus_type")
  bonusValue             Decimal?                @map("bonus_value") @db.Decimal(12, 2)
  isActive               Boolean                 @default(true) @map("is_active")
  validFrom              DateTime                @default(now()) @map("valid_from")
  validTo                DateTime?               @map("valid_to")
  createdAt              DateTime                @default(now()) @map("created_at")

  @@index([isActive, version])
  @@map("loyalty_program_configurations")
}
