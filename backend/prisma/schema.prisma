generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  ADMIN
  CASHIER
}

enum DocumentType {
  DNI
  PASSPORT
}

/// Employees: required data: first name, last name, phone and role.
model Employee {
  id        Int          @id @default(autoincrement())
  firstName String       @map("first_name") @db.VarChar(80)
  lastName  String       @map("last_name") @db.VarChar(80)
  phone     String       @db.VarChar(30)
  email     String       @unique @db.VarChar(150)
  role      EmployeeRole

  // Soft delete: record is kept, not removed
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  account Account?

  @@index([isActive])
  @@map("employees")
}

/// Customers: document, email (required, unique), phone (optional), first name, last name.
model Customer {
  id             Int          @id @default(autoincrement())
  firstName      String       @map("first_name") @db.VarChar(80)
  lastName       String       @map("last_name") @db.VarChar(80)
  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number") @db.VarChar(20)
  // Unique among ALL customers, active or not: a deactivated customer is reactivated, never re-created
  email          String       @unique @db.VarChar(150)
  phone          String?      @db.VarChar(30)

  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  // Soft delete: record is kept, not removed, to preserve history
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  statusChanges CustomerStatusChange[]
  account       Account?

  // The document identifies the customer at checkout: must not repeat
  @@unique([documentType, documentNumber], name: "unique_document")
  @@index([lastName, firstName])
  @@index([isActive])
  @@map("customers")
}

enum CustomerStatusAction {
  DEACTIVATED
  ACTIVATED
}

/// History of deactivations and reactivations of a customer (never deleted).
model CustomerStatusChange {
  id         Int                  @id @default(autoincrement())
  customerId Int                  @map("customer_id")
  action     CustomerStatusAction
  createdAt  DateTime             @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_status_changes")
}

enum AccountRole {
  ADMIN
  CASHIER
  CUSTOMER
}

/// Login credentials. Everyone logs in with an email, employees and customers alike.
/// Exactly one owner, matching the role: CUSTOMER -> customerId; ADMIN/CASHIER -> employeeId.
/// Enforced by the CHECK constraint "accounts_owner_matches_role_check", written by hand in the
/// migration (Prisma does not model CHECK constraints).
model Account {
  id           Int         @id @default(autoincrement())
  // Copy of Employee.email (not editable) or Customer.email (kept in sync when it changes).
  // One email = one account: the same person needs a different email per role.
  email        String      @unique @db.VarChar(150)
  passwordHash String      @map("password_hash")
  // Derived copy of Employee.role (source of truth); always CUSTOMER for customers
  role         AccountRole

  isActive Boolean @default(true) @map("is_active")

  employeeId Int? @unique @map("employee_id")
  customerId Int? @unique @map("customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessions Session[]

  @@map("accounts")
}

/// One row per login session. The refresh token is rotated in place on every use.
model Session {
  id        Int    @id @default(autoincrement())
  accountId Int    @map("account_id")
  // SHA-256 (hex) of the refresh token; the token itself is never stored
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  // Inactivity deadline: pushed forward on every refresh
  expiresAt         DateTime  @map("expires_at")
  // Hard limit: set at login, never changes
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("sessions")
}
