generator client {
  provider        = "prisma-client-js"
  // Unique indexes with a WHERE clause (unique only among active rows)
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// ENUMS
// =====================================================================

enum EmployeeRole {
  ADMIN
  CASHIER
}

enum DocumentType {
  DNI
  PASSPORT
}

enum AccountRole {
  ADMIN
  CASHIER
  CUSTOMER
}

/// ACTIVATED is no longer written (there is no customer reactivation); kept for old rows.
enum CustomerStatusAction {
  DEACTIVATED
  ACTIVATED
}

enum FirstConsumptionBonusType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ConsumptionStatus {
  REGISTERED
  VOIDED // final state
}

enum PointsLotStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  VOIDED // its consumption was voided; final state
}

enum PointsMovementType {
  CONSUMPTION_CREDIT
  VOID_REVERSAL
  MANUAL_ADJUSTMENT
  EXPIRATION
  REDEMPTION // Sprint 4
  // Sprint 5 (contrato S5 §2.7): gift points. They create a lot but never add to lifetime_points
  MISSION_REWARD
  BIRTHDAY_BONUS
}

// Sprint 4 (contrato S4 §2.1). DISABLED only by the System; DELETED is final ("Dada de baja")
enum RewardStatus {
  ACTIVE
  DISABLED
  INACTIVE
  DELETED
}

// Sprint 4 (§2.2). Only when status = DISABLED (CHECK)
enum RewardDisabledReason {
  OUT_OF_STOCK
  EXPIRED
}

// Sprint 4 (§2.3). Born CONFIRMED; the other four are final. There is no "PENDING"
enum RedemptionStatus {
  CONFIRMED
  USED
  REJECTED
  CANCELLED
  EXPIRED
}

// Sprint 4 (§2.4)
enum RedemptionOrigin {
  APP
  COUNTER
}

// Sprint 5 (BASE-5, contrato S5 §2.2). The mission of the catalog. DELETED is final ("Eliminar")
enum MissionStatus {
  ACTIVE
  DELETED
}

// Sprint 5 (§2.3, S5-15). What a mission measures
enum MissionObjectiveType {
  CONSUMPTION_COUNT
  CONSUMPTION_AMOUNT
}

// Sprint 5 (§2.1, "Misión mensual" state machine). COMPLETED is final if the mission has no reward (S5-4)
enum CustomerMissionStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
  EXPIRED
}

// Sprint 5 (§2.4, RF-050 to RF-053). PROMOTION is not an automatic message: no template, no switch
enum NotificationType {
  POINTS_EXPIRING
  BIRTHDAY
  PROMOTION
  MISSION
}

// Sprint 5 (§2.5). The only channel (S5-10)
enum NotificationChannel {
  EMAIL
}

// Sprint 5 (§2.6). SKIPPED: the type was switched off, or sending is off in the environment
enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

// Sprint 5 (§2.6.1, S5-36). A promotion is not stored, only each send
enum PromotionSendStatus {
  SCHEDULED
  SENT
  CANCELLED
}

enum AuditActorType {
  EMPLOYEE
  SYSTEM
}

enum AuditModule {
  EMPLOYEES
  CUSTOMERS
  CONSUMPTIONS
  POINTS
  REDEMPTIONS
  REWARDS
  MISSIONS
  CONFIGURATION
}

enum AuditAction {
  // EMPLOYEES
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_DEACTIVATED
  USER_ACCOUNT_CREATED
  USER_ACCOUNT_UPDATED
  USER_ACCOUNT_DEACTIVATED
  USER_ACCOUNT_REACTIVATED
  // CUSTOMERS
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_DEACTIVATED
  // CONSUMPTIONS
  CONSUMPTION_REGISTERED
  CONSUMPTION_VOIDED
  // POINTS
  POINTS_ADJUSTED
  POINTS_EXPIRED
  // REDEMPTIONS (Sprint 4)
  REDEMPTION_CONFIRMED
  REDEMPTION_USED
  REDEMPTION_REJECTED
  REDEMPTION_EXPIRED
  // REWARDS (Sprint 4)
  REWARD_CREATED
  REWARD_UPDATED
  REWARD_ACTIVATED
  REWARD_DEACTIVATED
  REWARD_DELETED
  REWARD_DISABLED
  REWARD_ENABLED
  // MISSIONS (Sprint 5)
  MISSION_CREATED
  MISSION_UPDATED
  MISSION_DELETED
  MISSION_COMPLETED
  MISSION_REWARD_CLAIMED
  MISSIONS_EXPIRED
  // CONFIGURATION
  POINTS_EQUIVALENCE_UPDATED
  POINTS_VALIDITY_UPDATED
  FIRST_CONSUMPTION_BONUS_UPDATED
  LEVELS_UPDATED
  LOGO_AND_MESSAGES_UPDATED // Sprint 5
  PROMOTIONS_UPDATED // Sprint 5 (not used: promotions are no longer stored, S5-36)
  FREQUENT_CUSTOMERS_UPDATED // Sprint 5, module CONFIGURATION
  // POINTS (Sprint 5)
  BIRTHDAY_BONUS_GRANTED
}

// =====================================================================
// EMPLOYEES
// =====================================================================

/// Employees: required data: first name, last name, email and role. Phone is optional.
model Employee {
  id        Int          @id @default(autoincrement())
  firstName String       @map("first_name") @db.VarChar(80)
  lastName  String       @map("last_name") @db.VarChar(80)
  phone     String?      @db.VarChar(30)
  email     String       @db.VarChar(150)
  role      EmployeeRole

  // Soft delete: record is kept, not removed. No reactivation.
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account?

  // Sprint 5: promotions this employee sent or scheduled
  promotionSends PromotionSend[]

  // Email must not repeat among ACTIVE employees: a deactivated employee frees it.
  @@unique([email], map: "employees_active_email_key", where: { isActive: true })
  @@index([email])
  @@index([isActive])
  @@map("employees")
}

// =====================================================================
// CUSTOMERS
// =====================================================================

/// Customers: document, email (required), phone (optional), first name, last name.
model Customer {
  id             Int          @id @default(autoincrement())
  firstName      String       @map("first_name") @db.VarChar(80)
  lastName       String       @map("last_name") @db.VarChar(80)
  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number") @db.VarChar(20)
  email          String       @db.VarChar(150)
  phone          String?      @db.VarChar(30)

  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  // Soft delete: record is kept, not removed, to preserve history. No reactivation.
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  // Sprint 5 (FOTO-PERFIL, contrato S5 §3.5.3): profile photo in Cloudinary. Delivery is
  // authenticated, so photo_url stays null and a signed URL is built from photo_public_id on each response
  photoPublicId String? @map("photo_public_id") @db.VarChar(255)
  photoUrl      String? @map("photo_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statusChanges   CustomerStatusChange[]
  account         Account?
  points          CustomerPoints?
  consumptions    Consumption[]
  pointsLots      PointsLot[]
  pointsMovements PointsMovement[]
  redemptions     Redemption[]
  missions        CustomerMission[]
  notifications   Notification[]

  // Document and email must not repeat among ACTIVE customers (PO decision, 2026-10-08): a
  // deactivated customer lost their points and can sign up again as a new customer.
  @@unique([documentType, documentNumber], map: "customers_active_document_key", where: { isActive: true })
  @@unique([email], map: "customers_active_email_key", where: { isActive: true })
  // Lookup by document also has to find inactive customers (checkout identification)
  @@index([documentType, documentNumber])
  @@index([lastName, firstName])
  @@index([isActive])
  @@map("customers")
}

/// History of deactivations of a customer (never deleted).
model CustomerStatusChange {
  id         Int                  @id @default(autoincrement())
  customerId Int                  @map("customer_id")
  action     CustomerStatusAction
  createdAt  DateTime             @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_status_changes")
}

// =====================================================================
// ACCOUNTS AND SESSIONS
// =====================================================================

/// Login credentials. Everyone logs in with an email, employees and customers alike.
/// Exactly one owner, matching the role: CUSTOMER -> customerId; ADMIN/CASHIER -> employeeId.
/// Enforced by the CHECK constraint "accounts_owner_matches_role_check", written by hand in the
/// migration (Prisma does not model CHECK constraints).
model Account {
  id           Int         @id @default(autoincrement())
  // Copy of Employee.email (not editable) or Customer.email (kept in sync when it changes).
  // Unique only among ACTIVE accounts.
  email        String      @db.VarChar(150)
  passwordHash String      @map("password_hash")
  // Derived copy of Employee.role (source of truth); always CUSTOMER for customers
  role         AccountRole

  isActive Boolean @default(true) @map("is_active")

  // true only for customer accounts created at checkout/admin (initial password = document)
  // until the customer changes it.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  // An employee always keeps the same account (user reactivation is kept)
  employeeId Int? @unique @map("employee_id")
  customerId Int? @unique @map("customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessions Session[]

  registeredConsumptions   Consumption[]    @relation("ConsumptionRegisteredBy")
  voidedConsumptions       Consumption[]    @relation("ConsumptionVoidedBy")
  performedPointsMovements PointsMovement[] @relation("PointsMovementPerformedBy")
  confirmedRedemptions     Redemption[]     @relation("RedemptionConfirmedBy")
  resolvedRedemptions      Redemption[]     @relation("RedemptionResolvedBy")

  @@unique([email], map: "accounts_active_email_key", where: { isActive: true })
  @@index([email])
  @@map("accounts")
}

/// One row per login session. The refresh token is rotated in place on every use.
model Session {
  id        Int    @id @default(autoincrement())
  accountId Int    @map("account_id")
  // SHA-256 (hex) of the refresh token; the token itself is never stored
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  // Inactivity deadline: pushed forward on every refresh
  expiresAt         DateTime  @map("expires_at")
  // Hard limit: set at login, never changes
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("sessions")
}

// =====================================================================
// LOYALTY CONFIGURATION
// =====================================================================

/// LEGACY (imported as version 1 of LoyaltyProgramConfiguration). Not read by the app.
model LoyaltyPointsConfiguration {
  id            Int      @id @default(1)
  baseAmount    Decimal  @map("base_amount") @db.Decimal(12, 2)
  pointsAwarded Int      @map("points_awarded")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("loyalty_points_configuration")
}

/// LEGACY (imported as version 1 of LoyaltyProgramConfiguration). Not read by the app.
model LoyaltyPointsValidityConfiguration {
  id                     Int      @id @default(1)
  pointsExpirationMonths Int      @default(12) @map("points_expiration_months")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("loyalty_points_validity_configuration")
}

/// LEGACY (imported as version 1 of LoyaltyProgramConfiguration). Not read by the app.
model FirstConsumptionBonusConfiguration {
  id         Int                    @id @default(1)
  bonusType  FirstConsumptionBonusType @map("bonus_type")
  bonusValue Decimal                @map("bonus_value") @db.Decimal(12, 2)
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  @@map("first_consumption_bonus_configuration")
}

/// Immutable version of all loyalty program settings. Exactly one version is active at a time.
/// Levels: BRONZE from 0 (fixed), SILVER and GOLD thresholds over lifetime points.
model LoyaltyProgramConfiguration {
  id                     Int                     @id @default(autoincrement())
  version                Int                     @unique
  baseAmount             Decimal?                @map("base_amount") @db.Decimal(12, 2)
  pointsAwarded          Int?                    @map("points_awarded")
  pointsExpirationMonths Int                     @default(12) @map("points_expiration_months")
  bonusType              FirstConsumptionBonusType? @map("bonus_type")
  bonusValue             Decimal?                @map("bonus_value") @db.Decimal(12, 2)
  // CHECK: silver > 0 and gold > silver (written by hand in the migration)
  silverMinPoints        Int                     @default(300) @map("silver_min_points")
  goldMinPoints          Int                     @default(800) @map("gold_min_points")
  // Sprint 5 (NIV-BEN, S5-26): informative text of each level; it does not change points
  bronzeBenefit          String?                 @map("bronze_benefit") @db.VarChar(255)
  silverBenefit          String?                 @map("silver_benefit") @db.VarChar(255)
  goldBenefit            String?                 @map("gold_benefit") @db.VarChar(255)
  // Sprint 5 (S5-22): a "frequent customer" has at least this many REGISTERED consumptions in the
  // month. CHECK 1-100 (written by hand in the migration)
  frequentMinConsumptions Int                    @default(3) @map("frequent_min_consumptions")
  isActive               Boolean                 @default(true) @map("is_active")
  validFrom              DateTime                @default(now()) @map("valid_from")
  validTo                DateTime?               @map("valid_to")
  createdAt              DateTime                @default(now()) @map("created_at")

  consumptions Consumption[]

  // Only one active version at a time (partial unique index, like customers)
  @@unique([isActive], map: "loyalty_program_configurations_one_active_key", where: { isActive: true })
  @@map("loyalty_program_configurations")
}

// =====================================================================
// CONSUMPTIONS
// =====================================================================

/// A consumption registered at checkout. Never edited: if wrong, it is voided and registered again.
/// Visible code "C-000141" is derived from the id (not stored).
model Consumption {
  id         Int @id @default(autoincrement())
  customerId Int @map("customer_id")

  amount      Decimal @db.Decimal(12, 2)
  points      Int
  bonusPoints Int     @default(0) @map("bonus_points")
  notes       String? @db.VarChar(255)

  // Snapshot of the configuration used (RF-014): later changes do not modify it
  configurationVersion Int     @map("configuration_version")
  baseAmount           Decimal @map("base_amount") @db.Decimal(12, 2)
  pointsAwarded        Int     @map("points_awarded")

  status ConsumptionStatus @default(REGISTERED)

  registeredByAccountId Int    @map("registered_by_account_id")
  // Employee's name at the moment of registering
  registeredByName      String @map("registered_by_name") @db.VarChar(161)

  createdAt DateTime @default(now()) @map("created_at")

  // CHECK: all null when REGISTERED, all set when VOIDED
  voidedAt          DateTime? @map("voided_at")
  voidedByAccountId Int?      @map("voided_by_account_id")
  voidedByName      String?   @map("voided_by_name") @db.VarChar(161)
  voidedReason      String?   @map("voided_reason") @db.VarChar(500)

  customer      Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  configuration LoyaltyProgramConfiguration @relation(fields: [configurationVersion], references: [version], onDelete: Restrict)
  registeredBy  Account                     @relation("ConsumptionRegisteredBy", fields: [registeredByAccountId], references: [id], onDelete: Restrict)
  voidedBy      Account?                    @relation("ConsumptionVoidedBy", fields: [voidedByAccountId], references: [id], onDelete: Restrict)

  pointsLot       PointsLot?
  pointsMovements PointsMovement[]

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([registeredByAccountId, createdAt])
  @@index([status])
  @@map("consumptions")
}

// =====================================================================
// POINTS
// =====================================================================

/// One row per customer: current balance, debt and lifetime points (level).
/// Every operation that moves points locks this row first (SELECT ... FOR UPDATE).
/// Invariant: balance = SUM(remaining of ACTIVE lots) - debt.
model CustomerPoints {
  customerId     Int      @id @map("customer_id")
  // Can be negative (voided consumption whose points were already spent)
  balance        Int      @default(0)
  // CHECK >= 0
  debt           Int      @default(0)
  // CHECK >= 0. CONSUMPTION_CREDIT - VOID_REVERSAL; defines the level
  lifetimePoints Int      @default(0) @map("lifetime_points")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([lifetimePoints])
  @@map("customer_points")
}

/// Batch of accredited points with its own expiration (snapshot of the validity at accreditation).
model PointsLot {
  id            Int  @id @default(autoincrement())
  customerId    Int  @map("customer_id")
  // Lot created by a consumption (at most one per consumption); null for manual ADD adjustments
  consumptionId Int? @unique @map("consumption_id")

  // CHECK initial > 0 and 0 <= remaining <= initial
  initialPoints   Int             @map("initial_points")
  remainingPoints Int             @map("remaining_points")
  accreditedAt    DateTime        @default(now()) @map("accredited_at")
  expiresAt       DateTime        @map("expires_at")
  status          PointsLotStatus @default(ACTIVE)
  expiredAt       DateTime?       @map("expired_at")

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  consumption Consumption? @relation(fields: [consumptionId], references: [id], onDelete: Restrict)

  movements PointsMovement[]

  // Daily expiration job
  @@index([status, expiresAt])
  // FIFO and next expirations per customer
  @@index([customerId, status, expiresAt])
  @@map("points_lots")
}

/// Append-only ledger of points (trigger rejects UPDATE, DELETE and TRUNCATE).
model PointsMovement {
  id            Int  @id @default(autoincrement())
  customerId    Int  @map("customer_id")
  // Required for CONSUMPTION_CREDIT and VOID_REVERSAL (CHECK)
  consumptionId Int? @map("consumption_id")
  lotId         Int? @map("lot_id")
  // Sprint 4: required for REDEMPTION and only for it (CHECK points_movements_redemption_check)
  redemptionId  Int? @map("redemption_id")
  // Sprint 5: required for MISSION_REWARD and only for it (CHECK points_movements_mission_check).
  // UNIQUE: a claimed mission has at most one reward movement
  customerMissionId Int? @unique @map("customer_mission_id")

  type         PointsMovementType
  // Signed, never 0 (CHECK). Sign depends on the type
  points       Int
  // Customer balance after the movement; can be negative
  balanceAfter Int                @map("balance_after")
  // Required for MANUAL_ADJUSTMENT (CHECK)
  reason       String?            @db.VarChar(500)

  // null = System (automatic processes)
  performedByAccountId Int?   @map("performed_by_account_id")
  // Snapshot of the employee's name, or "Sistema"
  performedByName      String @map("performed_by_name") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  consumption Consumption? @relation(fields: [consumptionId], references: [id], onDelete: Restrict)
  lot         PointsLot?   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  redemption  Redemption?  @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  performedBy Account?     @relation("PointsMovementPerformedBy", fields: [performedByAccountId], references: [id], onDelete: Restrict)
  customerMission CustomerMission? @relation(fields: [customerMissionId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([consumptionId])
  @@index([lotId])
  @@map("points_movements")
}

// =====================================================================
// REWARDS AND REDEMPTIONS (Sprint 4, BASE-4, contrato S4 §3.15)
// =====================================================================

/// Reward of the catalog. CHECK constraints and the partial unique index on the name are
/// written by hand in the migration 20261107120000_sprint4_base4_rewards_redemptions (Prisma
/// cannot model them):
/// - points BETWEEN 1 AND 1000000; stock NULL (no limit) or BETWEEN 0 AND 100000; used_count >= 0
/// - disabled_reason set if and only if status = DISABLED
/// - deleted_at set if and only if status = DELETED
/// - UNIQUE (lower(trim(name))) WHERE status <> 'DELETED' ("rewards_active_name_key")
model Reward {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(80)
  description    String?               @db.VarChar(255)
  points         Int
  // null = no stock limit ("Sin límite")
  stock          Int?
  // Last day it can be redeemed, Argentina time. null = never expires ("No vence")
  expiresAt      DateTime?             @map("expires_at") @db.Date
  status         RewardStatus          @default(ACTIVE)
  disabledReason RewardDisabledReason? @map("disabled_reason")
  // USED redemptions ("Más canjeadas")
  usedCount      Int                   @default(0) @map("used_count")
  // Sprint 5 (US-34, contrato S5 §3.5.2): photo in Cloudinary, public delivery (photo_url is its secure_url)
  photoPublicId  String?               @map("photo_public_id") @db.VarChar(255)
  photoUrl       String?               @map("photo_url") @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")

  redemptions Redemption[]

  // Daily expiration job (US-37)
  @@index([status, expiresAt])
  // Admin listing order
  @@index([updatedAt])
  @@map("rewards")
}

/// A redemption. Born CONFIRMED and lasts 15 minutes; it discounts nothing until it is USED.
/// CHECK constraints written by hand in the same migration:
/// - code ~ '^[A-HJ-NP-Z2-9]{6}$' (no 0, O, 1 or I)
/// - points > 0; expires_at = created_at + 15 minutes
/// - confirmed_by_account_id set if and only if origin = COUNTER
/// - resolved_at null if and only if status = CONFIRMED
/// - rejection_reason set if and only if status = REJECTED
/// - balance_before and balance_after set if and only if status = USED
model Redemption {
  id         Int              @id @default(autoincrement())
  code       String           @unique @db.Char(6)
  customerId Int              @map("customer_id")
  rewardId   Int              @map("reward_id")
  // Snapshot of the reward when confirmed: later changes do not modify it
  rewardName String           @map("reward_name") @db.VarChar(80)
  points     Int
  status     RedemptionStatus @default(CONFIRMED)
  origin     RedemptionOrigin

  // Employee who confirmed it at the counter (null when origin = APP)
  confirmedByAccountId Int?    @map("confirmed_by_account_id")
  confirmedByName      String? @map("confirmed_by_name") @db.VarChar(161)

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  resolvedAt          DateTime? @map("resolved_at")
  // null for the System and for CANCELLED (the customer is never an actor)
  resolvedByAccountId Int?      @map("resolved_by_account_id")
  // Employee's name snapshot or "Sistema"; null for CANCELLED
  resolvedByName      String?   @map("resolved_by_name") @db.VarChar(200)
  rejectionReason     String?   @map("rejection_reason") @db.VarChar(500)

  // Only for USED: balance before and after the discount
  balanceBefore Int? @map("balance_before")
  balanceAfter  Int? @map("balance_after")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reward      Reward   @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  confirmedBy Account? @relation("RedemptionConfirmedBy", fields: [confirmedByAccountId], references: [id], onDelete: Restrict)
  resolvedBy  Account? @relation("RedemptionResolvedBy", fields: [resolvedByAccountId], references: [id], onDelete: Restrict)

  pointsMovements PointsMovement[]

  @@index([customerId, createdAt])
  // Expiration (US-44)
  @@index([status, expiresAt])
  // confirmedCount
  @@index([rewardId, status])
  @@index([createdAt])
  @@map("redemptions")
}

// =====================================================================
// MISSIONS, NOTIFICATIONS AND PROMOTION SENDS (Sprint 5, BASE-5, contrato S5 §3.15)
// =====================================================================

/// Monthly mission of the catalog. CHECK constraints and the partial unique index on the name are
/// written by hand in the migration 20261112130000_sprint5_base5_missions_notifications (Prisma cannot
/// model them):
/// - target > 0, and a whole number when objective_type = CONSUMPTION_COUNT
/// - days_of_week only with values 1 to 7
/// - time_from and time_to both or none, and time_from < time_to
/// - reward_points NULL or 1 to 100000
/// - end_month >= start_month
/// - deleted_at set if and only if status = DELETED
/// - UNIQUE (lower(trim(name))) WHERE status <> 'DELETED' ("missions_active_name_key")
model Mission {
  id            Int                  @id @default(autoincrement())
  name          String               @db.VarChar(80)
  description   String?              @db.VarChar(255)
  objectiveType MissionObjectiveType @map("objective_type")
  target        Decimal              @db.Decimal(12, 2)
  // 1 = Monday ... 7 = Sunday. null (or empty) = every day. Argentina time
  daysOfWeek    Int[]                @map("days_of_week") @db.SmallInt
  // Time range of the day, Argentina time. Both or none
  timeFrom      DateTime?            @map("time_from") @db.Time()
  timeTo        DateTime?            @map("time_to") @db.Time()
  // null = no reward (the mission ends COMPLETED, S5-4)
  rewardPoints  Int?                 @map("reward_points")
  // First day of the month it starts to apply, and of the last month (null = repeats every month)
  startMonth    DateTime             @map("start_month") @db.Date
  endMonth      DateTime?            @map("end_month") @db.Date
  // Changes that apply from pending_changes.appliesFrom (S5-20: an edit rules from next month)
  pendingChanges Json?               @map("pending_changes")
  status        MissionStatus        @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deletedAt     DateTime?            @map("deleted_at")

  customerMissions CustomerMission[]

  @@map("missions")
}

/// The mission of one customer in one month. Objective, condition and reward are a SNAPSHOT of the
/// mission when it was assigned (S5-20). CHECK constraints written by hand in the same migration:
/// - 0 <= progress <= target
/// - the dates, claimed_by and expiration_reason agree with the status:
///   IN_PROGRESS: none of them; COMPLETED: completed_at; CLAIMED: completed_at, claimed_at and claimed_by;
///   EXPIRED: expired_at and expiration_reason
/// - claimed_by is CUSTOMER or SYSTEM
model CustomerMission {
  id         Int       @id @default(autoincrement())
  missionId  Int       @map("mission_id")
  customerId Int       @map("customer_id")
  // First day of the month
  period     DateTime  @db.Date

  // Snapshot of the mission at assignment
  objectiveType MissionObjectiveType @map("objective_type")
  target        Decimal              @db.Decimal(12, 2)
  daysOfWeek    Int[]                @map("days_of_week") @db.SmallInt
  timeFrom      DateTime?            @map("time_from") @db.Time()
  timeTo        DateTime?            @map("time_to") @db.Time()
  rewardPoints  Int?                 @map("reward_points")

  progress Decimal               @default(0) @db.Decimal(12, 2)
  status   CustomerMissionStatus @default(IN_PROGRESS)

  completedAt      DateTime? @map("completed_at")
  claimedAt        DateTime? @map("claimed_at")
  expiredAt        DateTime? @map("expired_at")
  // CUSTOMER or SYSTEM (the customer is never an actor in the audit, but the claim records who did it)
  claimedBy        String?   @map("claimed_by") @db.VarChar(10)
  // "Fin de mes" or "Misión dada de baja"
  expirationReason String?   @map("expiration_reason") @db.VarChar(100)

  mission  Mission  @relation(fields: [missionId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Present only when the reward was claimed (MISSION_REWARD)
  pointsMovement PointsMovement?

  // A mission is assigned once per customer and month
  @@unique([missionId, customerId, period])
  // End-of-month process (US-32)
  @@index([status, period])
  @@index([customerId, period])
  @@map("customer_missions")
}

/// Message of an AUTOMATIC notification (one row per type: POINTS_EXPIRING, BIRTHDAY and MISSION).
/// PROMOTION has no template (S5-37). CHECK type <> 'PROMOTION' written by hand in the migration.
model NotificationTemplate {
  type      NotificationType @id
  active    Boolean          @default(true)
  subject   String           @db.VarChar(120)
  body      String           @db.VarChar(1000)
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("notification_templates")
}

/// Single row (id = 1): notification settings. No logo columns (S5-35). CHECK id = 1 and
/// birthday_bonus_points between 0 and 10000 (0 = no gift) written by hand in the migration.
model NotificationSettings {
  id                  Int      @id @default(1)
  birthdayBonusPoints Int      @default(100) @map("birthday_bonus_points")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

/// Every notification, sent, failed or skipped. Append-only (trigger rejects UPDATE, DELETE and
/// TRUNCATE), like audit_logs. CHECK constraints written by hand in the migration:
/// - (type = 'PROMOTION') = (promotion_send_id IS NOT NULL)
/// - error is set if and only if status = FAILED
/// A resent notification points to the one that failed (resent_from_id, UNIQUE: only one resend);
/// that the original is FAILED is checked by the service.
model Notification {
  id              Int                 @id @default(autoincrement())
  type            NotificationType
  channel         NotificationChannel
  // The email the message was sent to, at that moment
  recipient       String              @db.VarChar(150)
  customerId      Int                 @map("customer_id")
  // Already with the variables replaced
  subject         String              @db.VarChar(120)
  body            String              @db.VarChar(1000)
  status          NotificationStatus
  error           String?             @db.VarChar(500)
  // "lot:{id}", "birthday:{year}", "mission:{customer_mission_id}", "promotion-send:{id}",
  // "resend:{id of the one that failed}"
  dedupeKey       String              @map("dedupe_key") @db.VarChar(100)
  promotionSendId Int?                @map("promotion_send_id")
  resentFromId    Int?                @unique @map("resent_from_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  promotionSend PromotionSend? @relation(fields: [promotionSendId], references: [id], onDelete: Restrict)
  resentFrom    Notification?  @relation("NotificationResend", fields: [resentFromId], references: [id], onDelete: Restrict)
  resends       Notification[] @relation("NotificationResend")

  // The same type to the same customer for the same reason is sent only once
  @@unique([type, customerId, dedupeKey])
  @@map("notifications")
}

/// One send of a promotion (S5-36, S5-39). There is no table of promotions: only each send is
/// stored. CHECK constraints written by hand in the migration:
/// - level is BRONZE, SILVER or GOLD (null = every active customer)
/// - SCHEDULED: scheduled_at and no sent_at; SENT: sent_at; CANCELLED: cancelled_at
/// - cancelled_at only when status = CANCELLED
model PromotionSend {
  id                  Int                 @id @default(autoincrement())
  // With {nombre} not replaced yet
  subject             String              @db.VarChar(120)
  body                String              @db.VarChar(1000)
  level               String?             @db.VarChar(10)
  // null = it went out right away
  scheduledAt         DateTime?           @map("scheduled_at")
  status              PromotionSendStatus
  sentAt              DateTime?           @map("sent_at")
  cancelledAt         DateTime?           @map("cancelled_at")
  // Set when it goes out
  recipients          Int?
  createdByEmployeeId Int                 @map("created_by_employee_id")
  createdAt           DateTime            @default(now()) @map("created_at")

  createdBy     Employee       @relation(fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  notifications Notification[]

  // Process of scheduled sends (US-15)
  @@index([status, scheduledAt])
  @@map("promotion_sends")
}

// =====================================================================
// AUDIT
// =====================================================================

/// Append-only record of sensitive operations (trigger rejects UPDATE, DELETE and TRUNCATE).
/// Actor is always an employee or the System, never a customer. Each row is a snapshot.
model AuditLog {
  id             Int            @id @default(autoincrement())
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actorType      AuditActorType @map("actor_type")
  // null for SYSTEM
  actorAccountId Int?           @map("actor_account_id")
  // Snapshot of the employee's name, or "Sistema"
  performedBy    String         @map("performed_by") @db.VarChar(200)

  // Nullable only for old rows with no equivalent (sessions, self sign-up); the listing excludes them
  module      AuditModule?
  actionCode  AuditAction? @map("action_code")
  description String?      @db.VarChar(300)

  // Affected customer (snapshot). No FK, to keep the immutable table independent
  affectedCustomerId   Int?          @map("affected_customer_id")
  affectedCustomerName String?       @map("affected_customer_name") @db.VarChar(161)
  documentType         DocumentType? @map("document_type")
  documentNumber       String?       @map("document_number") @db.VarChar(20)

  // C-000141, CJ-00412...
  operationCode String? @map("operation_code") @db.VarChar(20)

  // Ordered array of { label, value }, already formatted. Never passwords or hashes
  details Json @default("[]")

  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@index([module, createdAt])
  @@index([actorType, actorAccountId, createdAt])
  @@index([documentType, documentNumber, createdAt], map: "audit_logs_document_type_document_number_created_at_idx")
  @@index([operationCode])
  @@map("audit_logs")
}
